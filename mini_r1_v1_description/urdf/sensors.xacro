<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="CAM">
        <inertial>
            <origin xyz="-0.013346 -0.0007983 -0.00056953" rpy="0 0 0" />
            <mass value="0.001" /> <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find mini_r1_v1_description)/meshes/CAM.STL" />
            </geometry>
            <material name="gray_color">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find mini_r1_v1_description)/meshes/CAM.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="J_CAM" type="fixed">
        <origin xyz="0.1658 0.00050302 0.078" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="CAM" />
    </joint>

    <gazebo reference="CAM">
        <visual>
            <material>
                <ambient>0.5 0.5 0.5 1</ambient>
                <diffuse>0.5 0.5 0.5 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
                <emissive>0 0 0 0</emissive>
            </material>
        </visual>

        <sensor name="camera" type="rgbd_camera">
<gz_frame_id>CAM</gz_frame_id> <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>/r1_mini/camera</topic>
            
            <camera>
                <horizontal_fov>1.518436449</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>12.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <link name="IMU">
        <inertial>
            <origin xyz="1.1791E-05 -2.3893E-06 0.0089544" rpy="0 0 0" />
            <mass value="0.001" /> <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find mini_r1_v1_description)/meshes/IMU.STL" />
            </geometry>
            <material name="gray_color"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find mini_r1_v1_description)/meshes/IMU.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="J_IMU" type="fixed">
        <origin xyz="0.095 0 0.08" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="IMU" />
    </joint>

    <gazebo reference="IMU">
        <sensor name="imu" type="imu">
            <gz_frame_id>IMU</gz_frame_id> 
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>/r1_mini/imu</topic>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

</robot>